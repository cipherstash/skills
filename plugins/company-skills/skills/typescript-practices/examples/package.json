      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@fast-check/vitest": "0.5.0",
    "@types/node": "24.19.4",
    "@vitest/coverage-v8": "5.1.1",
    "fast-check": "4.11.0",
    "oxlint": "1.95.0",
    "oxlint-tsgolint": "7.0.2008",
    "publint": "0.3.25",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}
