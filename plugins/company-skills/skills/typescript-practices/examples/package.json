{
  "name": "@cipherstash/typescript-practices-examples",
  "version": "0.0.0",
  "description": "The examples that typescript-practices' references quote. CI runs the TypeScript check suite over this package. It is never published.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.23.0",
